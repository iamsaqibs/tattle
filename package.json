{
  "name": "@iamsaqibs/tattle",
  "version": "0.1.0",
  "description": "The lie detector for AI CLI tools: observe every file read, network connection and child process a Node CLI makes, and get a signed receipt.",
  "author": "Tattle contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tattle": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "!docs/assets/*.gif",
    "!docs/assets/*.png",
    "!docs/demo.tape",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:only": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node scripts/smoke-pack.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "keywords": [
    "security",
    "supply-chain",
    "audit",
    "cli",
    "observability",
    "ai-agents",
    "privacy",
    "receipts",
    "node"
  ],
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsaqibs/tattle.git"
  },
  "homepage": "https://github.com/iamsaqibs/tattle#readme",
  "bugs": {
    "url": "https://github.com/iamsaqibs/tattle/issues"
  }
}
